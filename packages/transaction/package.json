{
  "name": "@labdigital/paynl-transaction",
  "version": "0.2.0",
  "description": "PAY. Transaction Gateway Unit API's",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sdk": {
      "import": "./dist/sdk.js",
      "require": "./dist/sdk.cjs"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "keywords": [
    "Pay.nl"
  ],
  "author": "Lab Digital <opensource@labdigital.nl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/labd/paynl-js-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc --noEmit"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "dependencies": {
    "@readme/api-core": "^7.0.3"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^5.2.2"
  }
}
