{
	"name": "@labdigital/paynl-connect",
	"version": "0.2.0",
	"description": "PAY. Global Management System API's",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./sdk": {
			"types": "./dist/sdk.d.ts",
			"default": "./dist/sdk.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./package.json": "./package.json"
	},
	"type": "module",
	"keywords": [
		"Pay.nl"
	],
	"author": "Lab Digital <opensource@labdigital.nl>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/paynl-js-sdk.git",
		"directory": "packages/connect"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsdown",
		"tsc": "tsc --noEmit"
	},
	"files": [
		"dist",
		"openapi.json"
	],
	"dependencies": {
		"@readme/api-core": "^7.0.3"
	},
	"devDependencies": {
		"typescript": "^7.0.2"
	}
}
